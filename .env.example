# ==============================================================================
# finance-sync — Sanitized Environment Template (ZERO SECRETS)
# Copy this file to `.env` for local runs, or paste into Portainer Stack Env Vars.
# ==============================================================================

# --- Execution Mode ---
USE_MOCK_DATA=false
DRY_RUN=false
LOG_LEVEL=INFO
SQLITE_DB_PATH=/app/data/finance_sync.db

# --- BudgetBakers Wallet REST API ---
BUDGETBAKERS_BASE_URL=https://rest.budgetbakers.com/wallet
BUDGETBAKERS_TOKEN=replace-with-your-budgetbakers-jwt-token

# BudgetBakers Account UUIDs (Fetch via GET /v1/api/accounts)
BB_IBKR_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
BB_TR_CASH_ACCOUNT_ID=00000000-0000-0000-0000-000000000002
BB_TR_WEALTH_ACCOUNT_ID=00000000-0000-0000-0000-000000000003

# BudgetBakers System Category UUIDs (Standard Wallet system categories)
BB_CATEGORY_INVESTMENTS=5c5c232a-005a-8000-8000-000000000000
BB_CATEGORY_INTEREST_DIVIDENDS=5c5c2711-0064-8000-8000-000000000000
BB_CATEGORY_TRANSFER=5c5c4e21-00c8-8000-8000-000000000000
BB_CATEGORY_UNKNOWN_EXPENSE=5c5c32c9-0082-8000-8000-000000000000

# --- Interactive Brokers (IBKR Flex Web Service) ---
IBKR_FLEX_TOKEN=replace-with-your-ibkr-flex-token
IBKR_FLEX_QUERY_ID=replace-with-your-ibkr-flex-query-id
IBKR_POLL_INTERVAL_SECONDS=21600
IBKR_FLEX_WAIT_SECONDS=10

# --- Trade Republic (Private API / pytr) ---
TR_PHONE_NO=+49000000000
TR_PIN=0000
TR_SESSION_DIR=/app/data
TR_POLL_INTERVAL_SECONDS=900
TR_CARD_CUTOFF_DATE=2026-11-01T09:00:00Z

# --- Discord Bot (Interactive 2FA Renewal for Trade Republic) ---
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
DISCORD_CHANNEL_ID=000000000000000000
DISCORD_2FA_TIMEOUT_SECONDS=300
DISCORD_2FA_POLL_INTERVAL_SECONDS=3
